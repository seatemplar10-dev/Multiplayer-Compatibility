<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- RimWorld 1.7 (Waylith, .NET 10 CoreCLR). Game references + Unity facades: ..\Directory.Build.targets. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <PublicizeAsReferenceAssemblies>false</PublicizeAsReferenceAssemblies>
    <!-- References\*.dll are 1.6-era mod builds that reference UnityEngine.* modules -->
    <UseUnityFacades>true</UseUnityFacades>
    <OutputPath>..\1.7\Referenced\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>None</DebugType>
    <RootNamespace>Multiplayer.Compat</RootNamespace>
    <!-- ZombieLand reference DLL is giving a MSB3270 warning each time building the project, which is quite annoying. This prevents it. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Source/Multiplayer_Compat.csproj">
      <Private>false</Private>
    </ProjectReference>
    <PackageReference Include="Lib.Harmony">
      <Version>3.0.0-rc.2</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="RimWorld.MultiplayerAPI">
      <Version>0.6.0</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="Krafs.Publicizer">
      <Version>2.3.*</Version>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Reference Include="..\References\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
    <Publicize Include="VanillaGravshipExpanded" />
    <Publicize Include="Vehicles" />
    <Publicize Include="VFEC" />
    <Publicize Include="VFEEmpire" />
  </ItemGroup>
</Project>
